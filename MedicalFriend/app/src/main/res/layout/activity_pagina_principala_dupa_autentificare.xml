<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".paginaPrincipalaDupaAutentificare"
    android:background="@drawable/paginaprincipaladupaautentificare">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/ButonDisponibilitate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="56dp"
            android:layout_marginTop="158dp"
            android:layout_marginEnd="179dp"
            android:layout_marginBottom="533dp"
            android:background="@drawable/buton_pagini_afectiuni"
            android:text="@string/lista"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="visible"
            app:iconTint="#ffb7c8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.678"
            app:strokeColor="#EDE7F6"
            tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/ButonAlarma"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="206dp"
            android:layout_marginTop="249dp"
            android:layout_marginEnd="29dp"
            android:layout_marginBottom="444dp"
            android:background="@drawable/buton_pagini_afectiuni"
            android:text="@string/alarma"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="italic"
            android:visibility="visible"
            app:iconTint="#ffb7c8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.678"
            app:strokeColor="#EDE7F6"
            tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/ButonChatBot"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="63dp"
            android:layout_marginTop="354dp"
            android:layout_marginEnd="172dp"
            android:layout_marginBottom="335dp"
            android:background="@drawable/buton_pagini_afectiuni"
            android:text="@string/chat"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="italic"
            android:visibility="visible"
            app:iconTint="#ffb7c8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.678"
            app:strokeColor="#EDE7F6"
            tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/iesire"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="203dp"
            android:layout_marginTop="465dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="223dp"
            android:background="@drawable/buton_pagini_afectiuni"
            android:text="@string/iesire"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="italic"
            android:visibility="visible"
            app:iconTint="#ffb7c8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.678"
            app:strokeColor="#EDE7F6"
            tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>