<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaginaInregistrare"
    android:background="@drawable/inregistrare">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        tools:context="com.example.chmarax.logregform.RegistrationActivity">


        <AutoCompleteTextView
            android:id="@+id/atvUsernameReg"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="46dp"
            android:layout_marginTop="240dp"
            android:layout_marginEnd="53dp"
            android:layout_marginRight="53dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_rect"
            android:drawableStart="@drawable/icon_person"
            android:drawableLeft="@drawable/icon_person"
            android:drawablePadding="10dp"
            android:hint="@string/usernameReg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="#bcbcbc"
            android:textSize="15sp" />

        <AutoCompleteTextView
            android:id="@+id/atvEmailReg"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_below="@+id/atvUsernameReg"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="49dp"
            android:layout_marginRight="49dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_rect"
            android:drawableStart="@drawable/icon_mail"
            android:drawableLeft="@drawable/icon_mail"
            android:drawablePadding="10dp"
            android:hint="@string/emailReg"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="#bcbcbc"
            android:textSize="15sp" />


        <AutoCompleteTextView
            android:id="@+id/atvPasswordReg"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_below="@+id/atvEmailReg"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_marginStart="53dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="58dp"
            android:layout_marginRight="58dp"
            android:background="@drawable/rounded_rect"
            android:drawableStart="@drawable/icon_password"
            android:drawableLeft="@drawable/icon_password"
            android:drawablePadding="10dp"
            android:hint="@string/passwordReg"
            android:inputType="textPassword"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="#bcbcbc"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="176dp"
            android:layout_height="57dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="112dp"
            android:layout_marginBottom="175dp"
            android:background="@drawable/buton_pagini_afectiuni"
            android:text="@string/text_pagina_cont_buton_signup"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="italic"
            android:visibility="visible"
            app:iconTint="#ffb7c8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.678"
            app:strokeColor="#EDE7F6"
            tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>